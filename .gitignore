__pycache__/
*.py[cod]

# Raw listing-page snapshots are transient input to the clean stage within
# a single pipeline run -- nothing reads them across runs. They are the
# single largest driver of repository growth (raw HTML committed every 4
# hours x 5 sources) and are not needed for provenance: cleaned/normalised
# output (data/processed/) and diff history (data/diff/) already carry
# source URL, fetch timestamp, and content forward. See ARCHITECTURE.md
# "Generated-data retention policy". Existing committed snapshots are left
# in git history untouched (no history rewrite); this only stops new ones.
data/raw/*/*.json
!data/raw/.gitkeep
